{
  "multi_fig_002": {
    "figure_key": "multi_fig_002",
    "subfolder": "multi_language",
    "questions": [
      {
        "id": "ml002_q1",
        "question": "在70%稀疏率下，Per-Layer perplexity与Per-Output perplexity的近似比值是多少？",
        "expected_answer": "~2",
        "answer_type": "approximate",
        "category": "computation"
      },
      {
        "id": "ml002_q2",
        "question": "在哪个稀疏率下，Per-Layer perplexity首次超过10^1？",
        "expected_answer": "60%",
        "answer_type": "exact",
        "category": "value_reading"
      },
      {
        "id": "ml002_q3",
        "question": "从60%到80%稀疏率，Per-Output perplexity大约增长了多少倍？",
        "expected_answer": "~50-60x",
        "answer_type": "approximate",
        "category": "computation"
      },
      {
        "id": "ml002_q4",
        "question": "在多少个稀疏率下，Per-Output和Per-Layer perplexity的差异在视觉上无法区分（即两个柱子看起来高度相同）？",
        "expected_answer": "3",
        "answer_type": "exact",
        "category": "counting"
      },
      {
        "id": "ml002_q5",
        "question": "在哪个稀疏率下，Per-Layer和Per-Output perplexity在对数尺度上的绝对差距最大？",
        "expected_answer": "80%",
        "answer_type": "exact",
        "category": "comparison"
      }
    ]
  },
