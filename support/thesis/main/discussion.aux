\@writefile{lof}{\contentsline {figure}{\numberline {7.1}{\ignorespaces \textbf  {Rank flow across research questions.} Each line traces a model's rank from description quality (RQ1) through comprehension (RQ3) to behavioural dynamics (RQ4). GPT-5.2 leads on description but drops to 3rd on behaviour. Claude rises from 5th to 2nd. Gemini is the only model that maintains a top-2 rank across all three evaluations.}}{58}{figure.caption.57}\protected@file@percent }
\newlabel{fig:rank-flow}{{7.1}{58}{\textbf {Rank flow across research questions.} Each line traces a model's rank from description quality (RQ1) through comprehension (RQ3) to behavioural dynamics (RQ4). GPT-5.2 leads on description but drops to 3rd on behaviour. Claude rises from 5th to 2nd. Gemini is the only model that maintains a top-2 rank across all three evaluations}{figure.caption.57}{}}
