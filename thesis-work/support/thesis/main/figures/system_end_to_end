digraph SciFigEval {
	graph [bgcolor=white compound=true concentrate=false fontname=Helvetica fontsize=10 margin=0.15 nodesep=0.30 pad=0.3 rankdir=TB ranksep=0.50 splines=ortho]
	node [color=black fillcolor=white fontname=Helvetica fontsize=9 penwidth=0.8 style=filled]
	edge [arrowsize=0.6 color=black fontname=Helvetica fontsize=7 penwidth=0.6]

	/* ================================================================
	   Phase 1 — Corpus acquisition
	   ================================================================ */
	subgraph cluster_1 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 1   Corpus acquisition" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		corpus [label="<<datastore>>\nPaper corpus\narXiv · CCL\nWirtschaftsdienst · ISA" height=0.9 shape=cylinder width=2.0]
		extract [label="<<component>>\nFigure extraction\nextract_figure_pages.py" height=0.75 shape=component width=2.3]
		figs [label="figures\n1,005 PNG" height=0.55 shape=note width=1.4]
	}

	/* ================================================================
	   Phase 2 — Human annotation
	   ================================================================ */
	subgraph cluster_2 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 2   Human annotation" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		labelstudio [label="<<component>>\nLabel Studio\n8 annotators · 4 languages" height=0.75 shape=component width=2.5]
		gt [label="<<datastore>>\nGround truth\n1,411 records · JSON" height=0.85 shape=cylinder width=2.0]
		atoms [label="<<datastore>>\nAtomic checklist\n120 figures · 2,252 atoms\ncritical | important | minor" fillcolor="#E8F5E9" height=0.95 shape=cylinder width=2.4]
	}

	/* ================================================================
	   Phase 3 — Probe generation
	   ================================================================ */
	subgraph cluster_3 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 3   Probe generation" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		seed [label="<<component>>\nLLM seeder\n+ 3-expert review panel" height=0.75 shape=component width=2.3]
		probes [label="<<datastore>>\nProbe set\nA1 hallucination\nA2 caption bias\nA3 visual degradation\nA4 prompt reverse\nA5 misleading detection" height=1.3 shape=cylinder width=2.2]
	}

	/* ================================================================
	   Phase 4 — Prompt engineering
	   ================================================================ */
	subgraph cluster_4 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 4   Prompt engineering" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		templates [label="<<datastore>>\nPrompt templates\n4 langs × 4 fig types\nEN · BG · CN · DE" fillcolor="#FFFDE7" height=0.9 shape=cylinder width=2.2]
		selector [label="<<component>>\nPrompt selector\nget_prompt(lang, type)\n4-level fallback" height=0.8 shape=component width=2.3]
		c1 [label="C1  Native prompt\ndirect answer" fillcolor="#C8E6C9" fontname="Helvetica-Bold" fontsize=8 height=0.6 shape=box width=1.8]
		c2 [label="C2  English-only\nablation" fillcolor="#BBDEFB" fontname="Helvetica-Bold" fontsize=8 height=0.6 shape=box width=1.8]
		c3 [label="C3  CCoT\nvisual reasoning" fillcolor="#F8BBD0" fontname="Helvetica-Bold" fontsize=8 height=0.6 shape=box width=1.8]
	}

	/* ================================================================
	   Phase 5 — Inference + visual transforms
	   ================================================================ */
	subgraph cluster_5 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 5   Inference + visual transforms" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		transforms [label="<<component>>\nVisual transforms\n9 degradations\njpeg · noise · blur\nrotation · in-paper" height=1.0 shape=component width=2.3]
		azure [label="<<node>>\nAzure\nGPT-5.2 · Phi-4" height=0.65 shape=box3d width=1.6]
		oproute [label="<<node>>\nOpenRouter\nClaude-4.6 · LLaMA-4\nGemma-3 · Qwen3-VL" height=0.8 shape=box3d width=2.2]
		vertex [label="<<node>>\nVertex AI\nGemini-3.1-Pro" height=0.65 shape=box3d width=1.6]
		mut [label="<<component>>\nFigureAnnotator\n13 models · T = 0\n3 prompt conditions" height=0.9 shape=component width=2.5]
		responses [label="model responses\nJSON per figure\ndescriptions · answers\nCoT reasoning" height=0.85 shape=note width=2.0]
	}

	/* ================================================================
	   Phase 6 — Multi-judge scoring
	   ================================================================ */
	subgraph cluster_6 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 6   Multi-judge scoring" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		gpt4o [label="<<node>>\nGPT-4o\nAzure" height=0.6 shape=box3d width=1.5]
		mistral [label="<<node>>\nMistral Large 3\nAzure" height=0.6 shape=box3d width=1.7]

		subgraph cluster_mqm {
			color=gray40 fontsize=9 label="MQM track" labeljust=l margin=6 penwidth=0.4 style="rounded,dotted"
			mqm_std [label="<<component>>\nStandard MQM\nacc · comp · clar\n100 − Σ penalties" height=0.8 shape=component width=2.2]
			mqm_atomic [label="<<component>>\nAtomic MQM\natom checklist\nnormalized scoring" fillcolor="#E8F5E9" height=0.8 shape=component width=2.2]
		}

		ari [label="<<component>>\nA-R-I classifier\nadmittance · resistance\ninductance" height=0.8 shape=component width=2.3]
		scores [label="judge scores\nper model · per probe\nper language" height=0.7 shape=note width=1.8]
	}

	/* ================================================================
	   Phase 7 — Aggregation + output
	   ================================================================ */
	subgraph cluster_7 {
		color=gray55 fontname="Helvetica-Bold" fontsize=10 label="Phase 7   Aggregation + output" labeljust=l labelloc=t margin=8 penwidth=0.5 style="rounded,dashed"
		agg [label="<<component>>\nAggregation\nmean · CI · Cohen κ\nFleiss κ · Cronbach α" height=0.9 shape=component width=2.5]
		profile [label="Behavioural profile\n(A, R, I) + atomic MQM\nper model · per language\n× 3 prompt conditions" fontname="Helvetica-Bold" fontsize=10 height=1.0 peripheries=2 shape=note width=2.8]
		dashboard [label="<<component>>\nReact dashboard\nAzure Static Web Apps" fillcolor="#E3F2FD" height=0.7 shape=component width=2.2]
	}

	/* ================================================================
	   Edges — Phase 1
	   ================================================================ */
	corpus -> extract
	extract -> figs

	/* Phase 1 → 2 */
	figs -> labelstudio

	/* Phase 2 */
	labelstudio -> gt
	gt -> atoms [style=dashed]

	/* Phase 2 → 3 */
	gt -> seed

	/* Phase 3 */
	seed -> probes

	/* Phase 2 → 4 */
	gt -> selector [constraint=false style=dashed]

	/* Phase 4 */
	templates -> selector [style=dashed]
	selector -> c1
	selector -> c2
	selector -> c3

	/* Phase 3 → 5 */
	probes -> mut

	/* Phase 4 → 5 */
	c1 -> mut [constraint=false]
	c2 -> mut [constraint=false]
	c3 -> mut [constraint=false]

	/* Phase 1 → 5 */
	figs -> transforms [constraint=false style=dashed]
	transforms -> mut
	figs -> mut [constraint=false style=dashed]

	/* Phase 5 — backends */
	azure -> mut [arrowhead=none style=dotted]
	oproute -> mut [arrowhead=none style=dotted]
	vertex -> mut [arrowhead=none style=dotted]
	mut -> responses

	/* Phase 5 → 6 */
	responses -> mqm_std
	responses -> mqm_atomic
	responses -> ari
	atoms -> mqm_atomic [constraint=false style=dashed]

	/* Phase 6 — judges */
	gpt4o -> mqm_std [arrowhead=none style=dotted]
	gpt4o -> mqm_atomic [arrowhead=none style=dotted]
	mistral -> ari [arrowhead=none style=dotted]
	mistral -> mqm_std [arrowhead=none style=dotted]

	mqm_std -> scores
	mqm_atomic -> scores
	ari -> scores

	/* Phase 6 → 7 */
	scores -> agg
	agg -> profile [style=bold]
	agg -> dashboard [style=dashed]
}
