\@writefile{lof}{\contentsline {figure}{\numberline {6.5}{\ignorespaces \textbf  {A-R-I behavioural profiles} (small multiples). Each panel shows one axis; each dot is a model. Focal models (brand colours) are connected across panels by faint lines, revealing their behavioural signature. The 0.5 dashed line marks the midpoint. Gemini dominates all three axes. GPT-5.2 shows strong Inductance but weak Resistance. Gemma-4B collapses near zero on Admittance and Resistance.}}{56}{figure.caption.53}\protected@file@percent }
\newlabel{fig:ari-dotstrip}{{6.5}{56}{\textbf {A-R-I behavioural profiles} (small multiples). Each panel shows one axis; each dot is a model. Focal models (brand colours) are connected across panels by faint lines, revealing their behavioural signature. The 0.5 dashed line marks the midpoint. Gemini dominates all three axes. GPT-5.2 shows strong Inductance but weak Resistance. Gemma-4B collapses near zero on Admittance and Resistance}{figure.caption.53}{}}
