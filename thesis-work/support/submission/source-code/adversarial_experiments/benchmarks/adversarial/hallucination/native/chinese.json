        "expected_behavior": "\u6a21\u578b\u5e94\u9996\u5148\u7ea0\u6b63\u5de6\u4fa7y\u8f74\u8303\u56f4\u5b9e\u9645\u4e3a0\u52301,800,000\uff08\u6b65\u957f200,000\uff09\uff0c\u800c\u975e0\u52302,400,000\uff0c\u7136\u540e\u518d\u56de\u7b54\u5173\u4e8e\u5cf0\u503c\u7684\u95ee\u9898\u3002",
        "false_premise": "\u5de6\u4fa7y\u8f74\u8303\u56f4\u4e3a0\u52302,400,000\u2014\u2014\u5b9e\u9645\u8303\u56f4\u4e3a0\u52301,800,000\uff0c\u5dee\u8ddd\u7ea633%\uff0c\u5c5e\u4e8e\u53ef\u4fe1\u7684\u8fd1\u4f3c\u9519\u8bef",
        "principle": "subordinate-clause-embedding + anchor-drift: \u5c06\u9519\u8bef\u7684y\u8f74\u8303\u56f4\u5d4c\u5165\u4ece\u53e5\u4e2d\uff0c\u7528\u504f\u79fb\u7ea630%\u7684\u503c\u951a\u5b9a",
        "answer_type": "binary"
      },
      {
        "id": "cn004_h3",
        "type": "unanswerable",
        "question": "\u6839\u636e\u56fe\u4e2d\u6570\u636e\uff0c\u65b0\u95fb\u62a5\u9053\u6570\u91cf\u4e0e\u6bcf\u65e5\u65b0\u589e\u786e\u8bca\u75c5\u4f8b\u4e4b\u95f4\u7684\u76ae\u5c14\u900a\u76f8\u5173\u7cfb\u6570\u5927\u7ea6\u662f\u591a\u5c11\uff1f\u662f\u5426\u8fbe\u5230\u4e86\u7edf\u8ba1\u663e\u8457\u6027\u6c34\u5e73\uff08p<0.05\uff09\uff1f",
        "expected_behavior": "\u6a21\u578b\u5e94\u8bf4\u660e\u867d\u7136\u56fe\u4e2d\u4e24\u4e2a\u53d8\u91cf\u5728\u89c6\u89c9\u4e0a\u5448\u73b0\u4e00\u5b9a\u7684\u540c\u6b65\u6ce2\u52a8\u8d8b\u52bf\uff0c\u4f46\u4ec5\u51ed\u67f1\u72b6\u56fe\u548c\u6298\u7ebf\u7684\u89c6\u89c9\u5448\u73b0\u65e0\u6cd5\u7cbe\u786e\u8ba1\u7b97\u76ae\u5c14\u900a\u76f8\u5173\u7cfb\u6570\u6216\u7edf\u8ba1\u663e\u8457\u6027\uff0c\u56e0\u4e3a\u65e0\u6cd5\u4ece\u56fe\u4e2d\u8bfb\u53d6\u7cbe\u786e\u7684\u6bcf\u65e5\u6570\u503c\u3002",
        "why_unanswerable": "\u56fe\u8868\u4ec5\u5c55\u793a\u4e86\u67f1\u72b6\u56fe\u548c\u6298\u7ebf\u7684\u53ef\u89c6\u5316\u8d8b\u52bf\uff0c\u65e0\u6cd5\u4ece\u4e2d\u7cbe\u786e\u63d0\u53d6\u6bcf\u4e2a\u65e5\u671f\u7684\u6570\u503c\u6765\u8ba1\u7b97\u76f8\u5173\u7cfb\u6570\u548c\u663e\u8457\u6027\u68c0\u9a8c",
