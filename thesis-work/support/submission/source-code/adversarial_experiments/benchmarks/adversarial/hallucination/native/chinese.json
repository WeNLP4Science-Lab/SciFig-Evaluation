        "expected_behavior": "\u6a21\u578b\u5e94\u6307\u51fa\u56fe\u4e2d\u53ea\u6709\u4e09\u6761\u7ebf\uff08lattice\u3001FLAT\u3001OURS\uff09\uff0c\u4e0d\u5b58\u5728\u7b2c\u56db\u6761\u7eff\u8272\u865a\u7ebf\uff0c\u4e5f\u6ca1\u6709BERT\u57fa\u7ebf\u65b9\u6cd5\u7684\u6570\u636e\u3002",
        "false_element": "\u7b2c\u56db\u6761\u7eff\u8272\u865a\u7ebf\u4ee3\u8868BERT\u57fa\u7ebf\u2014\u2014\u56fe\u4e2d\u53ea\u6709\u4e09\u6761\u5b9e\u7ebf\uff08lattice\u7ea2\u8272\u65b9\u5f62\u3001FLAT\u84dd\u8272\u5706\u5f62\u3001OURS\u9ec4\u8272\u4e09\u89d2\u5f62\uff09\uff0cBERT\u662fNLP\u9886\u57df\u5e38\u89c1\u57fa\u7ebf\u4f46\u6b64\u56fe\u4e2d\u672a\u51fa\u73b0",
