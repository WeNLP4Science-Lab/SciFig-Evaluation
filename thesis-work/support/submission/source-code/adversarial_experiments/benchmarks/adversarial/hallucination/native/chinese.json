      {
        "id": "cn012_h2",
        "type": "contra",
        "question": "\u6839\u636e\u56fe\u8868\uff0cFLAT\u65b9\u6cd5\uff08\u84dd\u8272\u5706\u5f62\u6807\u8bb0\u7ebf\uff09\u5728\u6574\u4e2a\u8bad\u7ec3\u8fc7\u7a0b\u4e2d\u59cb\u7ec8\u4f18\u4e8eOURS\u65b9\u6cd5\uff08\u9ec4\u8272\u4e09\u89d2\u5f62\u6807\u8bb0\u7ebf\uff09\uff0c\u4e24\u8005\u5728epoch=16\u65f6\u7684F1\u5dee\u8ddd\u6700\u4e3a\u660e\u663e\u3002\u8bf7\u95ee\u8fd9\u4e2a\u6700\u7ec8\u5dee\u8ddd\u5927\u6982\u6709\u591a\u5927\uff1f",
        "expected_behavior": "\u6a21\u578b\u5e94\u7ea0\u6b63\u8fd9\u4e00\u9519\u8bef\u524d\u63d0\uff1a\u5b9e\u9645\u4e0aOURS\u65b9\u6cd5\u5728\u5927\u90e8\u5206\u8bad\u7ec3\u8fc7\u7a0b\u4e2d\u8868\u73b0\u4f18\u4e8e\u6216\u63a5\u8fd1FLAT\uff0c\u5c24\u5176\u5728epoch=16\u65f6OURS\u7684F1\uff08\u7ea60.90\uff09\u660e\u663e\u9ad8\u4e8eFLAT\uff08\u7ea60.88\uff09\uff0c\u5e76\u975eFLAT\u59cb\u7ec8\u4f18\u4e8eOURS\u3002",
        "false_premise": "FLAT\u59cb\u7ec8\u4f18\u4e8eOURS\u4e14\u5728epoch=16\u5dee\u8ddd\u6700\u5927\u2014\u2014\u5b9e\u9645\u4e0aOURS\u5728\u540e\u671f\u8d85\u8d8aFLAT\uff0cepoch=16\u65f6OURS\u7ea60.90\u800cFLAT\u7ea60.88",
        "principle": "relationship-reversal + temporal-specificity: \u98a0\u5012\u4e24\u6761\u63a5\u8fd1\u7ebf\u7684\u4f18\u52a3\u5173\u7cfb\uff0c\u5229\u7528\u5b83\u4eec\u5728\u65e9\u671f\u786e\u5b9e\u63a5\u8fd1\u7684\u4e8b\u5b9e\u589e\u52a0\u8ff7\u60d1\u6027",
        "answer_type": "binary"
      },
      {
        "id": "cn012_h3",
        "type": "unanswerable",
        "question": "\u4ece\u56fe\u4e2d\u4e09\u79cd\u65b9\u6cd5\u7684\u6536\u655b\u66f2\u7ebf\u6765\u770b\uff0cOURS\u65b9\u6cd5\u76f8\u6bd4FLAT\u5728\u6bcf\u4e2aepoch\u7684\u5e73\u5747\u8bad\u7ec3\u65f6\u95f4\u5927\u7ea6\u51cf\u5c11\u4e86\u591a\u5c11\uff1f",
        "expected_behavior": "\u6a21\u578b\u5e94\u6307\u51fa\u867d\u7136\u56fe\u8868\u6807\u9898\u6d89\u53ca\u2018\u63a8\u7406\u901f\u5ea6\u5bf9\u7167\u2019\uff0c\u4f46\u56fe\u4e2d\u5b9e\u9645\u5c55\u793a\u7684\u662fF1\u5206\u6570\u968fepoch\u7684\u53d8\u5316\uff0c\u5e76\u672a\u5305\u542b\u4efb\u4f55\u5173\u4e8e\u8bad\u7ec3\u65f6\u95f4\u6216\u8ba1\u7b97\u6548\u7387\u7684\u4fe1\u606f\uff0c\u65e0\u6cd5\u4ece\u56fe\u4e2d\u63a8\u65ad\u6bcf\u4e2aepoch\u7684\u8bad\u7ec3\u65f6\u957f\u3002",
        "why_unanswerable": "\u56fe\u8868\u4ec5\u5c55\u793aF1\u5206\u6570vs\u8bad\u7ec3\u8f6e\u6570\uff0c\u4e0d\u5305\u542b\u4efb\u4f55\u65f6\u95f4\u6216\u8ba1\u7b97\u5f00\u9500\u4fe1\u606f\uff1b\u867d\u7136\u6807\u9898\u63d0\u5230\u2018\u901f\u5ea6\u5bf9\u7167\u2019\uff0c\u4f46\u56fe\u4e2d\u6570\u636e\u7ef4\u5ea6\u4e0d\u652f\u6301\u65f6\u95f4\u6bd4\u8f83",
        "principle": "caption-content-gap: \u5229\u7528\u6807\u9898\u4e2d\u2018\u901f\u5ea6\u5bf9\u7167\u2019\u4e0e\u56fe\u4e2d\u5b9e\u9645\u5185\u5bb9\uff08F1 vs epoch\uff09\u4e4b\u95f4\u7684\u8bed\u4e49\u5dee\u8ddd\uff0c\u8bf1\u5bfc\u6a21\u578b\u4ece\u4e0d\u5b58\u5728\u7684\u7ef4\u5ea6\u63a8\u65ad",
