\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Description quality (MQM scores, 0--100) across conditions. Base = baseline with caption (250 figures). Transforms evaluated on 100-figure subset. Values show mean with 95\% bootstrap CI (subscript/superscript). Higher is better.}}{6}{table.caption.10}\protected@file@percent }
\newlabel{tab:mqm-results}{{2}{6}{Description quality (MQM scores, 0--100) across conditions. Base = baseline with caption (250 figures). Transforms evaluated on 100-figure subset. Values show mean with 95\% bootstrap CI (subscript/superscript). Higher is better}{table.caption.10}{}}
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Unified behavioral evaluation. \textbf  {Capability} shows accuracy (\%) on four question types (Cnt = counting, Cmp = computation, Cmpr = comparison, Pat = pattern analysis; 250 figures, averaged across two judges). \textbf  {Resistance} shows scores (0--1) for three hallucination probe types (Inex = inexist, Cont = contra, Unan = unanswerable; 250 figures) and caption bias resistance (CapB; 100 figures). \textbf  {Admittance} shows the percentage of probes where the model acknowledged visual uncertainty (Act = active targeted question, Pas = passive open-ended description; 50 figures). \textbf  {Inductance} shows the percentage of fabricated answers that were correct for context-inferable elements (Act = active, Pas = passive; 48 figures). \textbf  {Bold} = best per column, \underline  {underline} = second best.}}{6}{table.caption.11}\protected@file@percent }
\newlabel{tab:behavioral}{{3}{6}{Unified behavioral evaluation. \textbf {Capability} shows accuracy (\%) on four question types (Cnt = counting, Cmp = computation, Cmpr = comparison, Pat = pattern analysis; 250 figures, averaged across two judges). \textbf {Resistance} shows scores (0--1) for three hallucination probe types (Inex = inexist, Cont = contra, Unan = unanswerable; 250 figures) and caption bias resistance (CapB; 100 figures). \textbf {Admittance} shows the percentage of probes where the model acknowledged visual uncertainty (Act = active targeted question, Pas = passive open-ended description; 50 figures). \textbf {Inductance} shows the percentage of fabricated answers that were correct for context-inferable elements (Act = active, Pas = passive; 48 figures). \textbf {Bold} = best per column, \underline {underline} = second best}{table.caption.11}{}}
