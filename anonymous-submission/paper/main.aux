\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces MQM degradation across evaluation conditions. \textbf  {(a)} Slope chart showing MQM trajectories for 8 models across perceptual transforms, page-context embedding, and adversarial conditions. GPT-5.2 (blue), Gemini (green), and Phi-4 (red) are highlighted. Rotation causes the largest perceptual drop; in-paper embedding tests contextual figure identification. Caption bias scores remain near baseline because the MQM judge does not reliably detect embedded false claims (\S  \ref {sec:results}). \textbf  {(b)} Delta heatmap showing MQM change from matched baseline on the same 100 figures. Red = degradation, green = improvement.}}{6}{figure.caption.10}\protected@file@percent }
\newlabel{fig:degradation}{{2}{6}{MQM degradation across evaluation conditions. \textbf {(a)} Slope chart showing MQM trajectories for 8 models across perceptual transforms, page-context embedding, and adversarial conditions. GPT-5.2 (blue), Gemini (green), and Phi-4 (red) are highlighted. Rotation causes the largest perceptual drop; in-paper embedding tests contextual figure identification. Caption bias scores remain near baseline because the MQM judge does not reliably detect embedded false claims (\S \ref {sec:results}). \textbf {(b)} Delta heatmap showing MQM change from matched baseline on the same 100 figures. Red = degradation, green = improvement}{figure.caption.10}{}}
