digraph caption_bias_pipeline {
    rankdir=LR;
    bgcolor="transparent";
    dpi=300;
    pad=0.3;
    nodesep=0.5;
    ranksep=0.6;
    splines=true;

    node [fontname="Times New Roman", fontsize=9, penwidth=0.8];
    edge [fontname="Times New Roman", fontsize=7, color="#888888",
          arrowsize=0.5, penwidth=0.7];

    // --- Input ---
    corpus [
        shape=cylinder, style=filled, fillcolor="#E8F0FE",
        color="#4477AA", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#4477AA">«input»</FONT></TD></TR>
            <TR><TD><B>Figure + Caption</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">100 figures</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Stage 1 ---
    modifier [
        shape=box, style="filled,rounded", fillcolor="#E8F5E9",
        color="#228833", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#228833">«stage 1 · GPT-4o»</FONT></TD></TR>
            <TR><TD><B>Caption Modifier</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">70/30 rule · 2–3 false claims</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Stage 2 ---
    model [
        shape=box, style="filled,rounded", fillcolor="#FFF3E0",
        color="#EE6677", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#EE6677">«stage 2»</FONT></TD></TR>
            <TR><TD><B>VLM Description</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">image + modified caption</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Stage 3 ---
    judge [
        shape=box, style="filled,rounded", fillcolor="#F3E5F5",
        color="#AA3377", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#AA3377">«stage 3 · GPT-4o»</FONT></TD></TR>
            <TR><TD><B>A/B Judge</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">randomised order</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">image vs caption claim</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Output ---
    scores [
        shape=cylinder, style=filled, fillcolor="#FCE4EC",
        color="#C62828", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#C62828">«output»</FONT></TD></TR>
            <TR><TD><B>Resistance Score</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">image / caption per claim</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Edges (linear, no crossing) ---
    corpus -> modifier [label="caption", weight=10];
    modifier -> model [label="modified", weight=10];
    model -> judge [label="description", weight=10];
    judge -> scores [weight=10];
}
