digraph capability_pipeline {
    rankdir=LR;
    bgcolor="transparent";
    dpi=300;
    pad=0.3;
    nodesep=0.5;
    ranksep=0.6;
    splines=true;

    node [fontname="Times New Roman", fontsize=9, penwidth=0.8];
    edge [fontname="Times New Roman", fontsize=7, color="#888888",
          arrowsize=0.5, penwidth=0.7];

    // --- Input ---
    corpus [
        shape=cylinder, style=filled, fillcolor="#E8F0FE",
        color="#4477AA", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#4477AA">«input»</FONT></TD></TR>
            <TR><TD><B>Figure + GT</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">250 figures</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Stage 1 ---
    seeder [
        shape=box, style="filled,rounded", fillcolor="#E8F5E9",
        color="#228833", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#228833">«stage 1 · GPT-4o»</FONT></TD></TR>
            <TR><TD><B>Question Seeder</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">3 candidates × 4 categories</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Stage 2 ---
    validator [
        shape=box, style="filled,rounded", fillcolor="#FFF3E0",
        color="#EE6677", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#EE6677">«stage 2 · Mistral Large 3»</FONT></TD></TR>
            <TR><TD><B>Validator</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">5 quality criteria</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Stage 3 ---
    filter [
        shape=box, style="filled,rounded", fillcolor="#F3E5F5",
        color="#AA3377", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#AA3377">«stage 3»</FONT></TD></TR>
            <TR><TD><B>Filter + Human Review</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">1 per category retained</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Output ---
    questions [
        shape=cylinder, style=filled, fillcolor="#FCE4EC",
        color="#C62828", penwidth=0.8,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="7" COLOR="#C62828">«output»</FONT></TD></TR>
            <TR><TD><B>1,000 Questions</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="7">4 per figure</FONT></TD></TR>
        </TABLE>>
    ];

    // --- Edges (linear, no crossing) ---
    corpus -> seeder [label="image + GT", weight=10];
    seeder -> validator [label="candidates", weight=10];
    validator -> filter [label="accepted", weight=10];
    filter -> questions [weight=10];
}
