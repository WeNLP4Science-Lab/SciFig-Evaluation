digraph caption_bias_pipeline {
    rankdir=LR;
    bgcolor="transparent";
    dpi=300;
    pad=0.2;
    nodesep=0.3;
    ranksep=0.45;
    node [fontname="Helvetica", fontsize=8, penwidth=0.7];
    edge [fontname="Helvetica", fontsize=6, color="#888888", arrowsize=0.4, penwidth=0.6];

    fig [shape=cylinder, style=filled, fillcolor="#E8F0FE", color="#4477AA", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#4477AA">input</FONT></TD></TR>
            <TR><TD><B>Figure + GT</B></TD></TR>
        </TABLE>>];

    gen [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#E65100">GPT-4o</FONT></TD></TR>
            <TR><TD><B>Caption Modifier</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">70/30 rule</FONT></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">2-3 false claims</FONT></TD></TR>
        </TABLE>>];

    model [shape=box, style="filled,rounded", fillcolor="#E3F2FD", color="#1565C0", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#1565C0">VLM</FONT></TD></TR>
            <TR><TD><B>Description</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">image + modified cap</FONT></TD></TR>
        </TABLE>>];

    judge [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#E65100">GPT-4o Judge</FONT></TD></TR>
            <TR><TD><B>A/B Eval</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">randomised order</FONT></TD></TR>
        </TABLE>>];

    score [shape=box, style="filled,rounded", fillcolor="#F3E5F5", color="#AA3377", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#AA3377">output</FONT></TD></TR>
            <TR><TD><B>Resistance R</B></TD></TR>
        </TABLE>>];

    fig -> gen;
    gen -> model;
    model -> judge;
    judge -> score;
}
