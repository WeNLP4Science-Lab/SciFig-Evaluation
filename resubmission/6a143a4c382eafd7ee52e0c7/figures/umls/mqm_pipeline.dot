digraph mqm_pipeline {
    rankdir=LR;
    bgcolor="transparent";
    dpi=300;
    pad=0.2;
    nodesep=0.35;
    ranksep=0.5;
    node [fontname="Helvetica", fontsize=8, penwidth=0.7];
    edge [fontname="Helvetica", fontsize=6, color="#888888", arrowsize=0.4, penwidth=0.6];

    fig [shape=cylinder, style=filled, fillcolor="#E8F0FE", color="#4477AA", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#4477AA">input</FONT></TD></TR>
            <TR><TD><B>Figure + GT</B></TD></TR>
        </TABLE>>];

    checklist [shape=box, style="filled,rounded", fillcolor="#E8F5E9", color="#228833", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#228833">select</FONT></TD></TR>
            <TR><TD><B>Chart-Type</B></TD></TR>
            <TR><TD><B>Checklist</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">14/15/11 items</FONT></TD></TR>
        </TABLE>>];

    judge [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#E65100">GPT-4o</FONT></TD></TR>
            <TR><TD><B>Judge</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">coverage + correctness</FONT></TD></TR>
        </TABLE>>];

    engine [shape=box, style="filled,rounded", fillcolor="#E8F5E9", color="#228833", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#228833">rule-based</FONT></TD></TR>
            <TR><TD><B>Penalty Engine</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">binding + dedup</FONT></TD></TR>
        </TABLE>>];

    score [shape=box, style="filled,rounded", fillcolor="#F3E5F5", color="#AA3377", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#AA3377">output</FONT></TD></TR>
            <TR><TD><B>MQM Score</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">0-100</FONT></TD></TR>
        </TABLE>>];

    fig -> checklist;
    checklist -> judge;
    judge -> engine;
    engine -> score;
}
