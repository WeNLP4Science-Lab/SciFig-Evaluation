digraph blur_pipeline {
    rankdir=LR;
    bgcolor="transparent";
    dpi=300;
    pad=0.2;
    nodesep=0.3;
    ranksep=0.45;
    node [fontname="Helvetica", fontsize=8, penwidth=0.7];
    edge [fontname="Helvetica", fontsize=6, color="#888888", arrowsize=0.4, penwidth=0.6];

    fig [shape=cylinder, style=filled, fillcolor="#E8F0FE", color="#4477AA", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#4477AA">input</FONT></TD></TR>
            <TR><TD><B>Figure</B></TD></TR>
        </TABLE>>];

    ocr [shape=box, style="filled,rounded", fillcolor="#E8F5E9", color="#228833", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#228833">EasyOCR</FONT></TD></TR>
            <TR><TD><B>Text + Boxes</B></TD></TR>
        </TABLE>>];

    selector [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#E65100">GPT-4o</FONT></TD></TR>
            <TR><TD><B>Target Selector</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">adm. + ind.</FONT></TD></TR>
        </TABLE>>];

    blur [shape=box, style="filled,rounded", fillcolor="#E8F5E9", color="#228833", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#228833">match + blur</FONT></TD></TR>
            <TR><TD><B>Gaussian Blur</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">k=75, grey blend</FONT></TD></TR>
        </TABLE>>];

    review [shape=box, style="filled,rounded", fillcolor="#FCE4EC", color="#EE6677", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#EE6677">human</FONT></TD></TR>
            <TR><TD><B>Dashboard</B></TD></TR>
            <TR><TD><B>Review</B></TD></TR>
        </TABLE>>];

    output [shape=cylinder, style=filled, fillcolor="#F3E5F5", color="#AA3377", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#AA3377">output</FONT></TD></TR>
            <TR><TD><B>Confirmed</B></TD></TR>
            <TR><TD><B>Blur Images</B></TD></TR>
        </TABLE>>];

    fig -> ocr;
    ocr -> selector;
    selector -> blur;
    blur -> review;
    review -> output;
}
