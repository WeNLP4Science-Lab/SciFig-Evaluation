digraph active_passive {
    rankdir=TB;
    bgcolor="transparent";
    dpi=300;
    pad=0.2;
    nodesep=0.4;
    ranksep=0.4;
    node [fontname="Helvetica", fontsize=8, penwidth=0.7];
    edge [fontname="Helvetica", fontsize=6, color="#888888", arrowsize=0.4, penwidth=0.6];

    blur [shape=cylinder, style=filled, fillcolor="#E8F0FE", color="#4477AA", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#4477AA">input</FONT></TD></TR>
            <TR><TD><B>Blurred Figure</B></TD></TR>
        </TABLE>>];

    subgraph cluster_active {
        label=<<B>Active Probe</B>>;
        fontname="Helvetica"; fontsize=8;
        style="dashed,rounded"; color="#228833"; bgcolor="#F5FFF5";
        
        aq [shape=box, style="filled,rounded", fillcolor="#E8F5E9", color="#228833", penwidth=0.6,
            label=<<TABLE BORDER="0" CELLPADDING="0">
                <TR><TD><FONT POINT-SIZE="6">targeted question</FONT></TD></TR>
                <TR><TD><B>Model Answer</B></TD></TR>
            </TABLE>>];
        aj [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.6,
            label=<<TABLE BORDER="0" CELLPADDING="0">
                <TR><TD><FONT POINT-SIZE="6">judge</FONT></TD></TR>
                <TR><TD><FONT POINT-SIZE="7">admits? fabricates? correct?</FONT></TD></TR>
            </TABLE>>];
        aq -> aj;
    }

    subgraph cluster_passive {
        label=<<B>Passive Probe</B>>;
        fontname="Helvetica"; fontsize=8;
        style="dashed,rounded"; color="#AA3377"; bgcolor="#FFF5F8";
        
        pd [shape=box, style="filled,rounded", fillcolor="#FCE4EC", color="#AA3377", penwidth=0.6,
            label=<<TABLE BORDER="0" CELLPADDING="0">
                <TR><TD><FONT POINT-SIZE="6">open-ended description</FONT></TD></TR>
                <TR><TD><B>Model Description</B></TD></TR>
            </TABLE>>];
        pj [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.6,
            label=<<TABLE BORDER="0" CELLPADDING="0">
                <TR><TD><FONT POINT-SIZE="6">judge</FONT></TD></TR>
                <TR><TD><FONT POINT-SIZE="7">mentioned? admits? fab? correct?</FONT></TD></TR>
            </TABLE>>];
        pd -> pj;
    }

    blur -> aq;
    blur -> pd;
}
