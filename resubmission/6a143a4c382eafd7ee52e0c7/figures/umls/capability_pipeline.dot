digraph capability_pipeline {
    rankdir=LR;
    bgcolor="transparent";
    dpi=300;
    pad=0.2;
    nodesep=0.3;
    ranksep=0.45;
    node [fontname="Helvetica", fontsize=8, penwidth=0.7];
    edge [fontname="Helvetica", fontsize=6, color="#888888", arrowsize=0.4, penwidth=0.6];

    fig [shape=cylinder, style=filled, fillcolor="#E8F0FE", color="#4477AA", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#4477AA">input</FONT></TD></TR>
            <TR><TD><B>Figure + GT</B></TD></TR>
        </TABLE>>];

    seeder [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#E65100">GPT-4o</FONT></TD></TR>
            <TR><TD><B>Seeder</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">4 candidates</FONT></TD></TR>
        </TABLE>>];

    validator [shape=box, style="filled,rounded", fillcolor="#FFF3E0", color="#E65100", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#E65100">Validator</FONT></TD></TR>
            <TR><TD><B>Filter</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">correctness check</FONT></TD></TR>
        </TABLE>>];

    output [shape=box, style="filled,rounded", fillcolor="#F3E5F5", color="#AA3377", penwidth=0.7,
        label=<<TABLE BORDER="0" CELLPADDING="1">
            <TR><TD><FONT POINT-SIZE="6" COLOR="#AA3377">output</FONT></TD></TR>
            <TR><TD><B>4 Questions</B></TD></TR>
            <TR><TD><FONT POINT-SIZE="6">cnt · cmp · cmpr · pat</FONT></TD></TR>
        </TABLE>>];

    fig -> seeder;
    seeder -> validator;
    validator -> output;
}
